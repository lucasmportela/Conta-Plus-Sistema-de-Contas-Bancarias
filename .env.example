# Ambiente
APP_ENV=development
FLASK_DEBUG=false
SECRET_KEY=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
DATABASE_PATH=instance/contas.db

# URLs e proxy: obrigatórios em produção
PUBLIC_BASE_URL=https://conta.exemplo.com
TRUSTED_HOSTS=conta.exemplo.com
# Informe o número EXATO de proxies confiáveis entre a Internet e o Flask.
# Não copie o valor sem confirmar a topologia do provedor.
TRUSTED_PROXY_HOPS=1

# Conta pessoal Hotmail: SMTP com OAuth2/Modern Auth
MAIL_AUTH_MODE=oauth2
MAIL_SERVER=smtp-mail.outlook.com
MAIL_PORT=587
MAIL_USERNAME=seu-endereco@hotmail.com
MAIL_PASSWORD=
MAIL_FROM="Conta+ <seu-endereco@hotmail.com>"
MAIL_USE_TLS=true
MAIL_USE_SSL=false

# Microsoft Entra App Registration (não é senha da conta Hotmail)
MS_CLIENT_ID=seu-client-id
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MS_TOKEN_CACHE_ENCRYPTION_KEY=gere-uma-chave-fernet-e-mantenha-em-segredo
MS_TOKEN_CACHE_FILE=instance/hotmail_msal_cache.enc

# Tokens
EMAIL_VERIFICATION_TTL=3600
PASSWORD_RESET_TTL=1800

# Limitação de tentativas
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
LOGIN_BLOCK_SECONDS=900
LOGIN_ATTEMPT_RETENTION_SECONDS=86400

# Uma instância: sqlite. Múltiplas instâncias: redis compartilhado.
LOGIN_RATE_LIMIT_BACKEND=sqlite
REDIS_URL=
