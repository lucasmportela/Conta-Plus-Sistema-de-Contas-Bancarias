# Ambiente
APP_ENV=development
FLASK_DEBUG=false
SECRET_KEY=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
DATABASE_PATH=instance/contas.db

# Banco: sqlite local ou turso na nuvem
DATABASE_BACKEND=sqlite
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# URL e proxy: necessários em produção; Render informa o hostname automaticamente
PUBLIC_BASE_URL=
TRUSTED_HOSTS=
TRUSTED_PROXY_HOPS=1

# E-mail local: SMTP Gmail. Em Render Free: API HTTPS Brevo
MAIL_PROVIDER=smtp
MAIL_FROM="Conta+ <conta.exclusiva@gmail.com>"
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=conta.exclusiva@gmail.com
MAIL_PASSWORD=senha-de-app-google-sem-espacos
MAIL_USE_TLS=true
MAIL_USE_SSL=false
BREVO_API_KEY=

# Tokens
EMAIL_VERIFICATION_TTL=3600
PASSWORD_RESET_TTL=1800

# Limitação de tentativas
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
LOGIN_BLOCK_SECONDS=900
LOGIN_ATTEMPT_RETENTION_SECONDS=86400

# Uma instância: sqlite (local ou Turso). Redis opcional.
LOGIN_RATE_LIMIT_BACKEND=sqlite
REDIS_URL=
