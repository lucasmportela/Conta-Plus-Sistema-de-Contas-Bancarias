# Ambiente
APP_ENV=development
FLASK_DEBUG=false
SECRET_KEY=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
DATABASE_PATH=instance/contas.db

# URLs e proxy: obrigatórios em produção
PUBLIC_BASE_URL=https://conta.exemplo.com
TRUSTED_HOSTS=conta.exemplo.com
# Informe o número EXATO de proxies confiáveis entre a Internet e o Flask.
# Não copie o valor sem confirmar a topologia do provedor.
TRUSTED_PROXY_HOPS=1

# SMTP para confirmação de e-mail e recuperação de senha
MAIL_SERVER=smtp.exemplo.com
MAIL_PORT=587
MAIL_USERNAME=usuario-smtp
MAIL_PASSWORD=senha-smtp
MAIL_FROM=Conta+ <nao-responda@exemplo.com>
MAIL_USE_TLS=true
MAIL_USE_SSL=false

# Tokens
EMAIL_VERIFICATION_TTL=3600
PASSWORD_RESET_TTL=1800

# Limitação de tentativas
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
LOGIN_BLOCK_SECONDS=900
LOGIN_ATTEMPT_RETENTION_SECONDS=86400

# Uma instância: sqlite. Múltiplas instâncias: redis compartilhado.
LOGIN_RATE_LIMIT_BACKEND=sqlite
REDIS_URL=
